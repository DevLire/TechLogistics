{
  "expo": {
    "name": "TechLogistics",
    "slug": "TechLogistics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "techlogistics",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.anonymous.TechLogistics"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/adaptative-icon-foreground.png",
        "backgroundImage": "./assets/adaptative-icon-background.png",
        "monochromeImage": "./assets/adaptative-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.TechLogistics"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1a1e",
          "android": {
            "image": "./assets/adaptative-icon-foreground.png",
            "imageWidth": 420
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usePrecompiledHeaders": true
          }
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cac001d7-3fe2-4c42-b08e-de12ea8f6002"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cac001d7-3fe2-4c42-b08e-de12ea8f6002"
    }
  }
}
